# ============================================================
# StockSense — Monorepo Environment Configuration Template
# ============================================================

# Backend Configuration (Spring Boot)
SERVER_PORT=8080
DB_URL=jdbc:h2:file:./data/stocksense;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# For PostgreSQL in Production or Docker:
# DB_URL=jdbc:postgresql://localhost:5432/stocksense
# DB_USERNAME=stocksense
# DB_PASSWORD=stocksense
# DB_DRIVER=org.postgresql.Driver

# Security Secrets (Must be at least 256 bits)
JWT_SECRET=defaultDevSecretKeyThatShouldBeChangedInProductionAndMustBeAtLeast256BitsLong!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# OTP & CORS Configuration
OTP_DELIVERY_MODE=DEMO
FRONTEND_ORIGIN=http://localhost:5173

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:8080/api/v1
